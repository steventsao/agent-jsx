{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src"
  },
  "include": [
    "src"
  ],
  "exclude": [
    // Runtime-internal Effect engine: not a package export, and its
    // declarations would drag the (dev-only) effect packages into the
    // published type graph. See the header of src/durable.ts.
    "src/durable.ts"
  ]
}
